@* Ícones da interface.

   O aplicativo Windows usa os glifos da fonte Segoe MDL2 Assets. No navegador essa fonte
   só existe no Windows, e em qualquer outro sistema apareceria um quadrado vazio — por isso
   cada glifo foi redesenhado aqui em SVG, seguindo o mesmo desenho do aplicativo.
   O comentário ao lado de cada um registra o glifo correspondente no aplicativo. *@

<svg class="icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor"
     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name) {
        case "home":        // E80F — Operações em lote
            <path d="M3.5 10.6 12 3.6l8.5 7" />
            <path d="M5.8 9.4V20h12.4V9.4" />
            <path d="M10 20v-5.2h4V20" />
            break;
        case "search":      // E8D7 — Licenças / Alteração em lote
            <circle cx="10.6" cy="10.6" r="6.4" />
            <path d="m15.4 15.4 5 5" />
            break;
        case "report":      // E9F9 — Relatórios
            <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="2.6" />
            <path d="M8.2 16.4v-3.6M12 16.4V8.6M15.8 16.4v-5.6" />
            break;
        case "people":      // E716 — Grupos
            <circle cx="9.2" cy="8.4" r="3.2" />
            <path d="M3.6 19.4c0-3 2.5-4.8 5.6-4.8s5.6 1.8 5.6 4.8" />
            <path d="M16.2 6.1a3.2 3.2 0 0 1 0 6.1" />
            <path d="M17.6 15.1c1.8.5 2.8 1.8 2.8 4.3" />
            break;
        case "gear":        // E713 — Ferramentas / Alterar status / Substituir colaborador
            <circle cx="12" cy="12" r="3.1" />
            <path d="M19.3 13.1a7.6 7.6 0 0 0 0-2.2l1.9-1.5-2-3.4-2.3 1a7.6 7.6 0 0 0-1.9-1.1L14.6 3.5h-3.9l-.4 2.4c-.7.2-1.3.6-1.9 1.1l-2.3-1-2 3.4 1.9 1.5a7.6 7.6 0 0 0 0 2.2l-1.9 1.5 2 3.4 2.3-1c.6.5 1.2.8 1.9 1.1l.4 2.4h3.9l.4-2.4c.7-.3 1.3-.6 1.9-1.1l2.3 1 2-3.4-1.9-1.5Z" />
            break;
        case "processes":   // E9F5 — Processos
            <circle cx="12" cy="12" r="8.4" />
            <path d="M12 7.2V12l3.2 1.9" />
            break;
        case "lock":        // E72E — Conexão com a API / Gerenciar senhas
            <rect x="4.6" y="10.4" width="14.8" height="9.8" rx="2.2" />
            <path d="M8.2 10.4V7.9a3.8 3.8 0 0 1 7.6 0v2.5" />
            <path d="M12 14.3v2.2" />
            break;
        case "help":        // E897 — Ajuda e formatos
            <circle cx="12" cy="12" r="8.4" />
            <path d="M9.7 9.6a2.4 2.4 0 0 1 4.6.8c0 1.6-2.3 2-2.3 3.4" />
            <path d="M12 17.1h.01" />
            break;
        case "upgrade":     // E9D9 — Análise para Upgrade
            <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="2.6" />
            <path d="m7.4 15.2 3.2-3.6 2.6 2.2 3.4-4.4" />
            <path d="M16.6 9.4h-2.8M16.6 9.4v2.8" />
            break;
        case "person-add":  // E748 — Gerenciar membros
            <circle cx="10" cy="8.4" r="3.4" />
            <path d="M3.8 19.6c0-3.2 2.7-5.1 6.2-5.1 1.1 0 2.2.2 3.1.6" />
            <path d="M17.6 14.2v5.4M14.9 16.9h5.4" />
            break;
        case "mail":        // E715 — Mensagens recebidas
            <rect x="3.2" y="5.4" width="17.6" height="13.2" rx="2.4" />
            <path d="m3.9 7 7.2 5.1c.5.4 1.3.4 1.8 0L20.1 7" />
            break;
        case "send":        // E724 — Mensagens enviadas
            <path d="M20.6 3.9 3.6 10.3l6.9 2.6 2.6 6.9 7.5-15.9Z" />
            <path d="m10.5 12.9 4.4-4.4" />
            break;
        case "trash":       // E74D — Excluir contas
            <path d="M4.6 6.9h14.8" />
            <path d="M9.1 6.9V5.2a1.6 1.6 0 0 1 1.6-1.6h2.6a1.6 1.6 0 0 1 1.6 1.6v1.7" />
            <path d="M6.6 6.9 7.5 19a1.6 1.6 0 0 0 1.6 1.5h5.8a1.6 1.6 0 0 0 1.6-1.5l.9-12.1" />
            <path d="M10.4 10.4v6.2M13.6 10.4v6.2" />
            break;
        case "restore":     // E777 — Recuperar contas
            <path d="M4.2 12a7.8 7.8 0 1 0 2.4-5.6L3.6 9.2" />
            <path d="M3.4 4.4v5h5" />
            break;
        case "rename":      // E8AC — Renomear contas
            <path d="M13.6 5.4 18.6 10.4" />
            <path d="M11.4 7.6 4.6 14.4V19h4.6l6.8-6.8Z" />
            <path d="M12.8 20.4h7.8" />
            break;
        case "contact":     // E77B — Atualizar atributos
            <rect x="3.2" y="4.8" width="17.6" height="14.4" rx="2.4" />
            <circle cx="9.4" cy="10.6" r="2.2" />
            <path d="M6.2 16.2c0-1.6 1.4-2.6 3.2-2.6s3.2 1 3.2 2.6" />
            <path d="M15.2 9.8h3.2M15.2 13.4h3.2" />
            break;
        case "globe":       // E774 — Excluir zonas DNS
            <circle cx="12" cy="12" r="8.4" />
            <path d="M3.8 12h16.4" />
            <path d="M12 3.6c2.1 2.3 3.3 5.3 3.3 8.4S14.1 18.1 12 20.4c-2.1-2.3-3.3-5.3-3.3-8.4S9.9 5.9 12 3.6Z" />
            break;
        case "check":       // E73E — etapa concluída
            <path d="m5.4 12.4 4.2 4.2 9-9.2" />
            break;
        case "arrow-right":
            <path d="M4.4 12h15.2M13.6 6l6 6-6 6" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
